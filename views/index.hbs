    <header>
      <div>
        <h1>Dashboard</h1>
        <p>Tổng quan chi tiêu cửa hàng HN & HCM</p>
      </div>
      <button id="exportBtn">Xuất CSV</button>
    </header>

    <section class="topFilters" aria-label="Bộ lọc thời gian">
      <label class="dateFilter monthFilter"><span>Tháng</span>
        <input id="filterMonth" type="text" placeholder="Chọn tháng" />
      </label>
      <label class="dateFilter"><span>Từ ngày</span>
        <input id="filterDateFrom" type="text" placeholder="Chọn ngày" />
      </label>
      <label class="dateFilter"><span>Đến ngày</span>
        <input id="filterDateTo" type="text" placeholder="Chọn ngày" />
      </label>
      <div class="filterActions topFilterActions">
        <button id="applyFilters" type="button">Áp dụng</button>
        <button id="clearFilters" type="button" class="secondary filterClear">Xóa lọc</button>
      </div>
    </section>

    <section id="dashboard" class="cards">
      <div class="card"><span>Quỹ HN còn lại</span><strong id="hnBalance">0 đ</strong><small id="hnSpent">Đã chi: 0
          đ</small></div>
      <div class="card"><span>Quỹ HCM còn lại</span><strong id="hcmBalance">0 đ</strong><small id="hcmSpent">Đã chi: 0
          đ</small></div>
      <div class="card"><span>Công ty chi trả</span><strong id="companySpent">0 đ</strong><small>Tài khoản công ty</small>
      </div>
      <div class="card"><span>Tổng chi tháng này</span><strong id="monthSpent">0 đ</strong><small id="totalBudget">Ngân
          sách: 0 đ</small></div>
      <div class="card"><span>Tiền mặt cửa hàng dư</span><strong id="cashBalanceTotal">0 đ</strong><small
          id="cashReceivedTotal">Đã nhận: 0 đ</small></div>
      <div class="card warning"><span>Khoản thiếu ảnh</span><strong id="missingImages">0</strong><small>Cần bổ sung
          chứng từ</small></div>
    </section>

    <section class="grid">
      <div class="panel">
        <h2>Thiết lập quỹ đầu tháng</h2>
        <div class="row two">
          <label>Quỹ HN<input id="budgetHN" inputmode="numeric" placeholder="VD: 10000000" /></label>
          <label>Quỹ HCM<input id="budgetHCM" inputmode="numeric" placeholder="VD: 10000000" /></label>
        </div>
        <button id="saveBudgetBtn">Lưu quỹ</button>
        <p class="hint">Cần mật khẩu để điều chỉnh ngân sách.</p>
        <div class="cashStats">
          <h3>Tiền mặt cửa hàng</h3>
          <div id="cashStatRows"></div>
        </div>
      </div>

      <div id="addExpense" class="panel large">
        <h2>Thêm khoản chi</h2>
        <form id="expenseForm">
          <div class="row three">
            <label>Chi nhánh *
              <select id="branch" required></select>
            </label>
            <label>Chiều vận chuyển *
              <select id="route" required></select>
            </label>
            <label>Danh mục *
              <select id="category" required></select>
            </label>
          </div>
          <div class="row three">
            <label>Số tiền (VND) *<input id="amount" inputmode="numeric" placeholder="VD: 45000" required /></label>
            <label>Ai chi tiêu *<select id="spentBy" required></select></label>
            <label>Ngày chi *<input id="date" type="date" required /></label>
          </div>
          <div id="codNoInvoiceWrap" class="row one hidden">
            <label>Lý do không tính vào hóa đơn KH *
              <textarea id="codReason" placeholder="VD: Phí COD nội bộ, khách không bị thu khoản này"></textarea>
            </label>
          </div>
          <div id="codInvoiceWrap" class="row one hidden">
            <label>Mã khách hàng *
              <input id="expenseCustomerCode" placeholder="VD: KH001" />
            </label>
          </div>
          <label>Ghi chú<textarea id="note" placeholder="VD: Viettel lấy hàng Nhật Việt"></textarea></label>

          <div class="upload" id="dropZone">
            <input id="receipts" type="file" accept="image/*,.pdf" multiple hidden />
            <div class="uploadIcon">＋</div>
            <b>Kéo thả ảnh vào đây</b>
            <span>hoặc bấm để chọn tối đa 2 ảnh</span>
          </div>
          <div id="preview" class="preview"></div>
          <div class="actions"><button type="reset" class="secondary">Xóa trắng</button><button type="submit">Lưu khoản
              chi</button></div>
        </form>
      </div>
    </section>

    <section id="storePayment" class="panel">
      <h2>Thanh toán tại cửa hàng</h2>
      <form id="paymentForm">
        <div class="row three">
          <label>Cửa hàng *
            <select id="paymentBranch" required>
              <option value="">-- Chọn cửa hàng --</option>
              <option>HN</option>
              <option>HCM</option>
            </select>
          </label>
          <label>Chiều vận chuyển *
            <select id="paymentRoute" required></select>
          </label>
          <label>Người nhận tiền *
            <select id="paymentReceiver" required></select>
          </label>
        </div>
        <div id="otherReceiverWrap" class="row one hidden">
          <label>Tên người nhận khác *
            <input id="otherReceiver" placeholder="Nhập tên người nhận tiền" />
          </label>
        </div>
        <div class="row three">
          <label>Mã khách hàng *<input id="customerCode" placeholder="VD: KH001" required /></label>
          <label>Số tiền (VND) *<input id="paymentAmount" inputmode="numeric" placeholder="VD: 5000000" required /></label>
          <label>Ngày thanh toán *<input id="paymentDate" type="date" required /></label>
        </div>
        <label>Ghi chú<textarea id="paymentNote" placeholder="VD: Khách thanh toán tiền mặt tại cửa hàng"></textarea></label>

        <div class="upload" id="paymentDropZone">
          <input id="paymentReceipts" type="file" accept="image/*,.pdf" multiple hidden />
          <div class="uploadIcon">＋</div>
          <b>Kéo thả ảnh hoặc hóa đơn vào đây</b>
          <span>buộc phải có ít nhất 1 file, tối đa 2 file</span>
        </div>
        <div id="paymentPreview" class="preview"></div>
        <div class="actions"><button type="reset" class="secondary">Xóa trắng</button><button type="submit">Lưu thanh
            toán</button></div>
      </form>
    </section>

    <section id="expenseList" class="panel tablePanel">
      <div class="tableHeader">
        <div class="tableTitle">
          <h2>Danh sách chi tiêu</h2>
          <span id="expenseCount" class="resultCount"></span>
        </div>
        <div class="filters">
          <select id="filterBranch">
            <option value="">Tất cả chi nhánh</option>
          </select>
          <select id="filterRoute">
            <option value="">Tất cả chiều</option>
          </select>
          <select id="filterCategory">
            <option value="">Tất cả danh mục</option>
          </select>
          <select id="filterPerson">
            <option value="">Tất cả người chi</option>
          </select>
          <div class="filterSearch">
            <input id="search" placeholder="Tìm ghi chú..." />
          </div>
        </div>
      </div>
      <div class="tableWrap">
        <table>
          <thead>
            <tr>
              <th>Ngày</th>
              <th>CN</th>
              <th>Chiều</th>
              <th>Danh mục</th>
              <th>Ai chi</th>
              <th>Số tiền</th>
              <th>Ghi chú</th>
              <th>Ảnh</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="expenseRows"></tbody>
        </table>
      </div>
      <input id="receiptUpdateInput" type="file" accept="image/*,.pdf" multiple hidden />
    </section>

    <section id="paymentList" class="panel tablePanel">
      <div class="tableHeader compact">
        <div class="tableTitle">
          <h2>Bảng nạp tiền cửa hàng</h2>
          <span id="paymentCount" class="resultCount"></span>
        </div>
      </div>
      <div class="tableWrap">
        <table>
          <thead>
            <tr>
              <th>Ngày</th>
              <th>Cửa hàng</th>
              <th>Chiều</th>
              <th>Người nhận</th>
              <th>Mã khách</th>
              <th>Số tiền</th>
              <th>Ghi chú</th>
              <th>Hóa đơn/ảnh</th>
            </tr>
          </thead>
          <tbody id="paymentRows"></tbody>
        </table>
      </div>
    </section>

    <section class="panel tablePanel">
      <div class="tableHeader compact">
        <div class="tableTitle">
          <h2>Lịch sử thao tác</h2>
          <span class="resultCount">Theo dõi xoá và sửa số tiền</span>
        </div>
      </div>
      <div class="tableWrap">
        <table class="auditTable">
          <thead>
            <tr>
              <th>Thời gian</th>
              <th>Người thao tác</th>
              <th>Hành động</th>
              <th>Khoản chi</th>
              <th>Thay đổi</th>
            </tr>
          </thead>
          <tbody id="auditRows"></tbody>
        </table>
      </div>
    </section>

    <section id="reports" class="reports">
      <div class="panel">
        <h2>Chi phí theo chi nhánh</h2>
        <div id="branchReport"></div>
      </div>
      <div class="panel">
        <h2>Chi phí theo chiều</h2>
        <div id="routeReport"></div>
      </div>
      <div class="panel">
        <h2>Chi phí theo danh mục</h2>
        <div id="categoryReport"></div>
      </div>
      <div class="panel">
        <h2>Top người chi</h2>
        <div id="personReport"></div>
      </div>
    </section>
