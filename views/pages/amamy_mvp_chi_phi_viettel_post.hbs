<style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
    }
    .mvp-page {
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
    }
    header {
      display: block;
      background: linear-gradient(180deg, var(--blue), var(--blue2));;
      color: white;
      padding: 18px 28px;
      margin: 0 0 18px;
    }
    header h1 { margin: 0; font-size: 22px; color: white; overflow-wrap: anywhere; }
    header p { margin: 6px 0 0; color: #cbd5e1; font-size: 14px; }

    .wrap {
      display: grid;
      grid-template-columns: minmax(320px, 390px) minmax(0, 1fr);
      gap: 20px;
      padding: 20px 0;
      max-width: 100%;
      min-width: 0;
    }
    .card {
      background: white;
      min-width: 0;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, .08);
      padding: 18px;
    }
    h2 { font-size: 18px; margin: 0 0 16px; }
    label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin: 14px 0 6px;
    }
    input, select, textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 14px;
      background: white;
    }
    textarea { min-height: 70px; resize: vertical; }
    .hidden { display: none; }

    .page-main {
      min-width: 0;
      overflow: hidden;
    }
    .summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .box {
      padding: 16px;
      border-radius: 14px;
      background: white;
      box-shadow: 0 4px 16px rgba(15, 23, 42, .08);
    }
    .box span {
      display: block;
      color: #64748b;
      font-size: 13px;
      margin-bottom: 8px;
    }
    .box strong { font-size: 20px; }

    button {
      border: none;
      padding: 12px 16px;
      border-radius: 10px;
      background: #2563eb;
      color: white;
      font-weight: 700;
      cursor: pointer;
      margin-top: 16px;
      width: 100%;
    }
    button:hover { background: #1d4ed8; }
    .deleteBtn {
      width: auto;
      margin: 0;
      padding: 7px 10px;
      background: #dc2626;
      border-radius: 8px;
      font-size: 12px;
    }
    .deleteBtn:hover { background: #b91c1c; }

    table {
      width: 100%;
      min-width: 720px;
      border-collapse: collapse;
      background: #f7f8fa;
      overflow: hidden;
    }
    th, td {
      padding: 12px 10px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      font-size: 13px;
      vertical-align: top;
    }
    th { background: #f8fafc; color: #334155; }
    .badge {
      padding: 5px 9px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 12px;
      display: inline-block;
    }
    .green { background: #dcfce7; color: #166534; }
    .yellow { background: #fef3c7; color: #92400e; }
    .filters {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      margin-bottom: 14px;
    }
    .tableScroll {
      max-width: 100%;
      overflow-x: auto;
      border-radius: 14px;
      box-shadow: 0 4px 16px rgba(15, 23, 42, .08);
    }
    .topFilters button { width: auto; margin: 0; }
    .topFilters { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
    .topFilterActions { min-width: 0; }
    .note {
      margin-top: 14px;
      padding: 12px;
      border-radius: 10px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      color: #92400e;
      font-size: 13px;
      line-height: 1.5;
    }
    .sectionGap { margin-top: 24px; }
    @media (max-width: 1000px) {
      .wrap { grid-template-columns: minmax(0, 1fr); }
      .summary { grid-template-columns: 1fr 1fr; }
    }
  </style>
<div class="mvp-page">
<header>
    <h1>Amamy - Chi phí Viettel Post</h1>
    <p>Ghi nhận tổng tiền thực trả Viettel Post theo bill, và phân bổ chi phí theo từng chiều để phân tích riêng</p>
  </header>

  <div class="wrap">
    <section class="card">
      <h2>1. Thanh toán Viettel Post</h2>

      <label>Người chi</label>
      <select id="payer">
        <option>Long</option>
      </select>

      <label>Ngày</label>
      <input id="date" type="date" />

      <label>Số tiền (theo bill thực tế)</label>
      <input id="amount" type="text" inputmode="numeric" placeholder="Ví dụ: 30.000.000" oninput="formatMoneyInput(this); updatePreview();" />

      <label>Trạng thái</label>
      <select id="status">
        <option>Đã thanh toán</option>
        <option>Chưa thanh toán</option>
      </select>

      <label>Ghi chú</label>
      <textarea id="note" placeholder="Ghi chú: kỳ thanh toán, mã bill, nội dung..."></textarea>

      <div class="box" style="margin-top:14px;box-shadow:none;border:1px dashed #cbd5e1;padding:12px;">
        <span>Số tiền ghi nhận</span>
        <strong id="amountPreview">0 đ</strong>
      </div>

      <button onclick="addRecord()">Lưu phiếu</button>
    </section>

    <div class="page-main">
      <div class="summary">
        <div class="box"><span>Tổng chi phí</span><strong id="sumTotal">0 đ</strong></div>
        <div class="box"><span>Đã thanh toán</span><strong id="sumPaid">0 đ</strong></div>
        <div class="box"><span>Chưa thanh toán</span><strong id="sumUnpaid">0 đ</strong></div>
      </div>

      <section class="topFilters" aria-label="Bộ lọc thời gian" style="margin-bottom:14px;">
        <label class="dateFilter monthFilter"><span>Tháng</span>
          <input id="filterMonth" type="text" placeholder="Tất cả tháng" />
        </label>
        <label class="dateFilter"><span>Từ ngày</span>
          <input id="filterDateFrom" type="text" placeholder="Chọn ngày" />
        </label>
        <label class="dateFilter"><span>Đến ngày</span>
          <input id="filterDateTo" type="text" placeholder="Chọn ngày" />
        </label>
        <div class="filterActions topFilterActions">
          <button id="applyDateFilter" type="button">Áp dụng</button>
          <button id="clearDateFilter" type="button" class="filterClear">Xóa lọc</button>
        </div>
      </section>

      <section class="card" style="margin-bottom:14px;">
        <h2>Lọc dữ liệu</h2>
        <div class="filters">
          <select id="filterStatus" onchange="renderTable()">
            <option value="">Tất cả trạng thái</option>
            <option>Đã thanh toán</option>
            <option>Chưa thanh toán</option>
          </select>
        </div>
      </section>

      <div class="tableScroll">
        <table>
          <thead>
            <tr>
              <th>Ngày</th>
              <th>Người chi</th>
              <th>Số tiền</th>
              <th>Trạng thái</th>
              <th>Ghi chú</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card sectionGap">
    <h2>2. Phân bổ chi phí Viettel Post theo chiều</h2>

    <div class="summary">
      <div class="box"><span>Tổng thực chi Viettel Post</span><strong id="allocTotalSpend">0 đ</strong></div>
      <div class="box"><span>Đã phân bổ theo chiều</span><strong id="allocAllocated">0 đ</strong></div>
      <div class="box"><span>Chưa phân bổ</span><strong id="allocRemaining">0 đ</strong></div>
    </div>

    <div class="filters">
      <div>
        <label>Ngày</label>
        <input id="allocDate" type="date" />
      </div>
      <div>
        <label>Chiều</label>
        <select id="allocRoute"></select>
      </div>
      <div>
        <label>Số tiền phân bổ</label>
        <input id="allocAmount" type="text" inputmode="numeric" placeholder="Ví dụ: 14.000.000" oninput="formatMoneyInput(this);" />
      </div>
    </div>
    <button type="button" style="width:auto" onclick="addAllocation()">Lưu phân bổ</button>

    <div class="tableScroll" style="margin-top:16px;">
      <table>
        <thead>
          <tr>
            <th>Ngày</th>
            <th>Chiều</th>
            <th>Số tiền</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="allocTbody"></tbody>
      </table>
    </div>

    <div class="note">
      Lưu ý: Tổng phân bổ có thể khác tổng thực trả vì có thể khác kỳ/đơn đối soát. Mục đích là để cuối tháng biết mỗi chiều đã tốn bao nhiêu phí Viettel Post, phục vụ tính lãi gộp từng chiều. Bảng này chỉ dùng để phân tích, không cộng thêm lần nữa vào chi phí thực trả ở trên.
    </div>
  </div>
</div>

  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>
  <script>
    const routes = ["Việt Mỹ","Việt Úc","Việt Canada","Việt Pháp","Việt Nhật","Việt Séc","Việt Đức","Việt Châu Âu","Việt Châu Âu - Đông Lạnh","Nhật Việt","Đức Việt","Mỹ Việt","Úc Việt"];
    const PAGE_RECORD_TYPE = "chi-phi-viettel-post";
    const ALLOC_PAGE_RECORD_TYPE = "chi-phi-viettel-post-phan-bo-chieu";
    let records = [];
    let allocations = [];
    function currentMonthKey() {
      const d = new Date();
      return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0");
    }
    let dateFilters = { month: currentMonthKey(), dateFrom: "", dateTo: "" };
    let datePickers = {};

    const escapeHtml = value => String(value == null ? "" : value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

    async function requestJson(url, options) {
      const response = await fetch(url, options);
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || "Không thể lưu dữ liệu");
      return payload;
    }

    async function loadRecords() {
      const payload = await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}`);
      records = payload.records || [];
    }

    async function saveRecord(record) {
      const payload = await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ record })
      });
      records.unshift(payload.record);
    }

    async function deleteRecord(id) {
      const actor = prompt("Nhập tên người xoá");
      if (actor === null) return;
      if (!actor.trim()) {
        alert("Vui lòng nhập tên người xoá");
        return;
      }

      const password = prompt("Nhập mật khẩu xoá phiếu");
      if (password === null) return;

      try {
        await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}/${encodeURIComponent(id)}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actor, password })
        });
        records = records.filter(record => record.id !== id);
        renderTable();
      } catch (error) {
        alert(error.message);
      }
    }

    async function loadAllocations() {
      const payload = await requestJson(`/api/page-records/${ALLOC_PAGE_RECORD_TYPE}`);
      allocations = payload.records || [];
    }

    async function addAllocation() {
      const amount = parseMoneyValue(document.getElementById("allocAmount").value);
      if (!amount) {
        alert("Vui lòng nhập số tiền phân bổ");
        return;
      }

      try {
        const payload = await requestJson(`/api/page-records/${ALLOC_PAGE_RECORD_TYPE}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ record: {
            date: document.getElementById("allocDate").value,
            route: document.getElementById("allocRoute").value,
            amount
          }})
        });
        allocations.unshift(payload.record);
      } catch (error) {
        alert(error.message);
        return;
      }

      document.getElementById("allocAmount").value = "";
      renderAllocations();
    }

    async function deleteAllocation(id) {
      const actor = prompt("Nhập tên người xoá");
      if (actor === null) return;
      if (!actor.trim()) {
        alert("Vui lòng nhập tên người xoá");
        return;
      }

      const password = prompt("Nhập mật khẩu xoá phiếu");
      if (password === null) return;

      try {
        await requestJson(`/api/page-records/${ALLOC_PAGE_RECORD_TYPE}/${encodeURIComponent(id)}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actor, password })
        });
        allocations = allocations.filter(a => a.id !== id);
        renderAllocations();
      } catch (error) {
        alert(error.message);
      }
    }

    function parseMoneyValue(value) {
      return Number(String(value || "").replace(/\D/g, "")) || 0;
    }

    function formatMoneyInput(input) {
      const raw = input.value.replace(/\D/g, "");
      if (!raw) {
        input.value = "";
        return;
      }
      input.value = Number(raw).toLocaleString("vi-VN");
    }

    function money(n) {
      return Number(n || 0).toLocaleString("vi-VN") + " đ";
    }

    function matchesDateFilter(dateStr) {
      const iso = dateStr && /^\d{4}-\d{2}-\d{2}/.test(dateStr) ? dateStr.slice(0, 10) : null;
      if (!iso) return true;
      const { month, dateFrom, dateTo } = dateFilters;
      if (dateFrom || dateTo) {
        return (!dateFrom || iso >= dateFrom) && (!dateTo || iso <= dateTo);
      }
      if (month) return iso.slice(0, 7) === month;
      return true;
    }

    function setupDateFilterPickers() {
      if (typeof flatpickr !== "function") return;
      const locale = flatpickr.l10ns && flatpickr.l10ns.vn ? flatpickr.l10ns.vn : "default";
      const commonDateOptions = { altInput: true, altFormat: "d/m/Y", dateFormat: "Y-m-d", allowInput: true, locale, disableMobile: true };

      if (typeof monthSelectPlugin === "function") {
        datePickers.month = flatpickr(document.getElementById("filterMonth"), {
          altInput: true, altFormat: "F Y", dateFormat: "Y-m", locale, disableMobile: true,
          defaultDate: dateFilters.month,
          plugins: [new monthSelectPlugin({ shorthand: false, dateFormat: "Y-m", altFormat: "F Y" })],
          onChange: function(selectedDates, value) {
            dateFilters.month = value || "";
            renderTable();
          }
        });
      }
      datePickers.from = flatpickr(document.getElementById("filterDateFrom"), commonDateOptions);
      datePickers.to = flatpickr(document.getElementById("filterDateTo"), commonDateOptions);

      document.getElementById("applyDateFilter").onclick = function() {
        dateFilters.dateFrom = document.getElementById("filterDateFrom").value;
        dateFilters.dateTo = document.getElementById("filterDateTo").value;
        renderTable();
      };
      document.getElementById("clearDateFilter").onclick = function() {
        document.getElementById("filterMonth").value = "";
        document.getElementById("filterDateFrom").value = "";
        document.getElementById("filterDateTo").value = "";
        if (datePickers.month) datePickers.month.clear();
        if (datePickers.from) datePickers.from.clear();
        if (datePickers.to) datePickers.to.clear();
        dateFilters = { month: "", dateFrom: "", dateTo: "" };
        renderTable();
      };
    }

    function initFilters() {
      const allocRoute = document.getElementById("allocRoute");
      routes.forEach(r => allocRoute.appendChild(new Option(r, r)));
    }

    function updatePreview() {
      document.getElementById("amountPreview").textContent = money(parseMoneyValue(document.getElementById("amount").value));
    }

    async function addRecord() {
      const amount = parseMoneyValue(document.getElementById("amount").value);
      if (!amount) {
        alert("Vui lòng nhập số tiền chi phí");
        return;
      }

      try {
        await saveRecord({
          date: document.getElementById("date").value,
          payer: document.getElementById("payer").value,
          amount,
          status: document.getElementById("status").value,
          note: document.getElementById("note").value
        });
      } catch (error) {
        alert(error.message);
        return;
      }

      document.getElementById("amount").value = "";
      document.getElementById("note").value = "";
      updatePreview();
      renderTable();
    }

    function badgeClass(status) {
      return status === "Đã thanh toán" ? "green" : "yellow";
    }

    function renderTable() {
      const tbody = document.getElementById("tbody");
      const fs = document.getElementById("filterStatus").value;

      const filtered = records.filter(r =>
        (!fs || r.status === fs) &&
        matchesDateFilter(r.date)
      );

      tbody.innerHTML = filtered.map(r => `
        <tr>
          <td>${escapeHtml(r.date)}</td>
          <td>${escapeHtml(r.payer)}</td>
          <td><strong>${money(r.amount)}</strong></td>
          <td><span class="badge ${badgeClass(r.status)}">${escapeHtml(r.status)}</span></td>
          <td>${escapeHtml(r.note || "")}</td>
          <td><button class="deleteBtn" type="button" onclick="deleteRecord('${escapeHtml(r.id)}')">Xoá</button></td>
        </tr>
      `).join("");

      renderSummary(filtered);
      renderAllocations();
    }

    function renderSummary(data) {
      const total = data.reduce((s, r) => s + r.amount, 0);
      const paid = data.reduce((s, r) => s + (r.status === "Đã thanh toán" ? r.amount : 0), 0);
      const unpaid = data.reduce((s, r) => s + (r.status === "Chưa thanh toán" ? r.amount : 0), 0);

      document.getElementById("sumTotal").textContent = money(total);
      document.getElementById("sumPaid").textContent = money(paid);
      document.getElementById("sumUnpaid").textContent = money(unpaid);
    }

    function renderAllocations() {
      const filtered = allocations.filter(a => matchesDateFilter(a.date));

      document.getElementById("allocTbody").innerHTML = filtered.map(a => `
        <tr>
          <td>${escapeHtml(a.date)}</td>
          <td>${escapeHtml(a.route)}</td>
          <td><strong>${money(a.amount)}</strong></td>
          <td><button class="deleteBtn" type="button" onclick="deleteAllocation('${escapeHtml(a.id)}')">Xoá</button></td>
        </tr>
      `).join("");

      const allocatedTotal = filtered.reduce((s, a) => s + (Number(a.amount) || 0), 0);
      const realSpendTotal = records.filter(r => matchesDateFilter(r.date)).reduce((s, r) => s + r.amount, 0);

      document.getElementById("allocTotalSpend").textContent = money(realSpendTotal);
      document.getElementById("allocAllocated").textContent = money(allocatedTotal);
      document.getElementById("allocRemaining").textContent = money(realSpendTotal - allocatedTotal);
    }

    async function initPage() {
      initFilters();
      document.getElementById("date").valueAsDate = new Date();
      document.getElementById("allocDate").valueAsDate = new Date();
      setupDateFilterPickers();
      try {
        await Promise.all([loadRecords(), loadAllocations()]);
      } catch (error) {
        alert(error.message);
      }
      renderTable();
    }

    initPage();
  </script>
