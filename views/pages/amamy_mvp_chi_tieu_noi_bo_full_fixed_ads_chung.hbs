<style>
    * { box-sizing: border-box; }
    body { margin:0; font-family: Arial, sans-serif; background:#f4f6f8; color:#1f2937; }
    .mvp-page { max-width:100%; min-width:0; overflow:hidden; }
    header { display:block; background:linear-gradient(180deg, var(--blue), var(--blue2));; color:white; padding:18px 28px; margin:0 0 18px; }
    header h1 { margin:0; font-size:22px; color:white; overflow-wrap:anywhere; }
    header p { margin:6px 0 0; color:#cbd5e1; font-size:14px; }
    .wrap { display:grid; grid-template-columns:minmax(320px, 410px) minmax(0, 1fr); gap:20px; padding:20px 0; max-width:100%; min-width:0; }
    .card { min-width:0; background:white; border-radius:14px; box-shadow:0 4px 16px rgba(15,23,42,.08); padding:18px; }
    h2 { font-size:18px; margin:0 0 16px; }
    label { display:block; font-weight:700; font-size:13px; margin:14px 0 6px; }
    input, select, textarea {
      width:100%; padding:11px 12px; border:1px solid #d1d5db; border-radius:10px;
      font-size:14px; background:white;
    }
    textarea { min-height:70px; resize:vertical; }
    button {
      border:none; padding:12px 16px; border-radius:10px; background:#2563eb;
      color:white; font-weight:700; cursor:pointer; margin-top:16px; width:100%;
    }
    button:hover { background:#1d4ed8; }
    .deleteBtn {
      width:auto; margin:0; padding:7px 10px; background:#dc2626;
      border-radius:8px; font-size:12px;
    }
    .deleteBtn:hover { background:#b91c1c; }
    .hidden { display:none; }
    .page-main { min-width:0; overflow:hidden; }
    .summary { display:grid; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:12px; margin-bottom:20px; }
    .box { padding:14px; border-radius:14px; background:white; box-shadow:0 4px 16px rgba(15,23,42,.08); }
    .box span { display:block; color:#64748b; font-size:12px; margin-bottom:8px; }
    .box strong { font-size:18px; }
    .filters { display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:12px; margin-bottom:14px; }
    .tableScroll { max-width:100%; overflow-x:auto; border-radius:14px; box-shadow:0 4px 16px rgba(15,23,42,.08); }
    table { width:100%; min-width:1120px; border-collapse:collapse; background:#f7f8fa; overflow:hidden; }
    th, td { padding:11px 9px; border-bottom:1px solid #e5e7eb; text-align:left; font-size:13px; vertical-align:top; }
    th { background:#f8fafc; color:#334155; }
    .badge { padding:5px 9px; border-radius:999px; font-weight:700; font-size:12px; display:inline-block; }
    .green { background:#dcfce7; color:#166534; }
    .yellow { background:#fef3c7; color:#92400e; }
    .blue { background:#dbeafe; color:#1e40af; }
    .gray { background:#e5e7eb; color:#374151; }
    .preview { margin-top:14px; padding:12px; border-radius:10px; background:#f8fafc; border:1px dashed #cbd5e1; font-size:14px; }
    .preview strong { color:#2563eb; }
    .row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .topFilters button { width:auto; margin:0; }
    .topFilters { grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); }
    .topFilterActions { min-width:0; }
    @media (max-width:1200px) {
      .wrap { grid-template-columns:minmax(0, 1fr); }
      .summary { grid-template-columns:repeat(2,1fr); }
      .filters { grid-template-columns:repeat(2,1fr); }
    }
  </style>
<div class="mvp-page">
<header>
  <h1>Amamy - Marketing</h1>
  <p>MVP nhập chi phí: giá vốn đối tác, marketing, ads và chi phí khác</p>
</header>

<div class="wrap">
  <section class="card">
    <h2>Tạo phiếu chi</h2>

    <label>Người chi tiêu</label>
    <select id="payerType" onchange="renderForm()">
      <option>Long</option>
      <option>Người khác</option>
    </select>

    <div id="payerOtherBox" class="hidden">
      <label>Nhập tên người chi</label>
      <input id="payerOther" placeholder="Ví dụ: Liên, Duy..." />
    </div>

    <label>Ngày chi</label>
    <input id="date" type="date" />

    <label>Mục chi tiêu</label>
    <select id="category" onchange="renderForm()">
      <option value="cost">Thanh toán giá vốn đối tác</option>
      <option value="marketing">Thanh toán chi phí Marketing</option>
      <option value="ads">Thanh toán chi phí Ads</option>
      <option value="getspon">Phí Email Getspon</option>
      <option value="other">Chi phí khác</option>
    </select>

    <div id="routeBox">
      <label>Chọn chiều</label>
      <select id="route"></select>
    </div>
    <div id="adsRouteNote" class="hidden" style="margin-top:12px;padding:10px;border-radius:10px;background:#f8fafc;color:#64748b;font-size:13px;">
      Chi phí Ads đang ghi nhận chung. Cuối tháng kế toán/marketing mới phân bổ theo chiều.
    </div>
    <div id="getsponRouteNote" class="hidden" style="margin-top:12px;padding:10px;border-radius:10px;background:#f8fafc;color:#64748b;font-size:13px;">
      Phí Email Getspon dùng chung cho tất cả các chiều, không phân bổ theo chiều.
    </div>

    <div id="partnerBox">
      <label>Đối tác</label>
      <select id="partner" onchange="renderForm()">
        <option>Kinkin Logistic</option>
        <option>VietExpress</option>
        <option>Expolo</option>
        <option>Bay Online</option>
        <option>Huthui Cargo</option>
        <option>AE Express</option>
        <option>Đối tác khác</option>
      </select>
      <div id="partnerOtherBox" class="hidden">
        <label>Nhập tên đối tác</label>
        <input id="partnerOther" placeholder="Tên đối tác khác" />
      </div>
    </div>

    <div id="marketingBox" class="hidden">
      <label>Lý do Marketing</label>
      <select id="marketingReason" onchange="renderForm()">
        <option>KOL</option>
        <option>Tài trợ</option>
        <option>Quà tặng</option>
        <option>Event</option>
        <option>Content</option>
        <option>Thiết kế</option>
        <option>Chi phí khác</option>
      </select>
      <div id="marketingOtherBox" class="hidden">
        <label>Nhập lý do khác</label>
        <input id="marketingOther" placeholder="Ví dụ: booking group, thuê mẫu..." />
      </div>
    </div>

    <div id="adsBox" class="hidden">
      <label>Nền tảng Ads</label>
      <select id="adsPlatform" onchange="renderForm()">
        <option>Facebook</option>
        <option>TikTok</option>
        <option>Google</option>
        <option>Nền tảng khác</option>
      </select>
      <div id="adsPlatformOtherBox" class="hidden">
        <label>Nhập nền tảng khác</label>
        <input id="adsPlatformOther" placeholder="Ví dụ: Zalo Ads..." />
      </div>

      <label>Tài khoản Ads</label>
      <select id="adsAccount" onchange="renderForm()">
        <option>Tài khoản công ty</option>
        <option>Tài khoản Aka</option>
        <option>Tài khoản khác</option>
      </select>
      <div id="adsAccountOtherBox" class="hidden">
        <label>Nhập tên tài khoản Ads</label>
        <input id="adsAccountOther" placeholder="Tên tài khoản ads khác" />
      </div>
    </div>

    <div id="otherBox" class="hidden">
      <label>Tên chi phí khác</label>
      <input id="otherName" placeholder="Ví dụ: mua máy in, vật tư..." />
    </div>

    <label>Thanh toán bằng</label>
    <select id="paymentMethod">
      <option>STK cá nhân Long</option>
      <option>STK công ty</option>
      <option>Chuyển khoản công ty</option>
      <option>Thẻ Visa</option>
      <option>Khác</option>
    </select>

    <div class="row2">
      <div>
        <label>Số tiền</label>
        <input id="amount" type="text" inputmode="numeric" placeholder="Ví dụ: 11.000.000" oninput="formatMoneyInput(this); updatePreview();" />
      </div>
      <div>
        <label>Trạng thái</label>
        <select id="status">
          <option>Đã thanh toán</option>
          <option>Chưa thanh toán</option>
        </select>
      </div>
    </div>

    <label>Ghi chú</label>
    <textarea id="note" placeholder="Ghi chú: kỳ thanh toán, mã đơn, nội dung chi..."></textarea>

    <div class="preview">
      Số tiền ghi nhận: <strong id="amountPreview">0 đ</strong>
    </div>

    <button onclick="addRecord()">Lưu phiếu chi</button>
  </section>

  <div class="page-main">
    <div class="summary">
      <div class="box"><span>Tổng chi</span><strong id="sumTotal">0 đ</strong></div>
      <div class="box"><span>Giá vốn đối tác</span><strong id="sumCost">0 đ</strong></div>
      <div class="box"><span>Marketing</span><strong id="sumMarketing">0 đ</strong></div>
      <div class="box"><span>Ads</span><strong id="sumAds">0 đ</strong></div>
    </div>

    <section class="topFilters" aria-label="Bộ lọc thời gian" style="margin-bottom:14px;">
      <label class="dateFilter monthFilter"><span>Tháng</span>
        <input id="filterMonth" type="text" placeholder="Tất cả tháng" />
      </label>
      <label class="dateFilter"><span>Từ ngày</span>
        <input id="filterDateFrom" type="text" placeholder="Chọn ngày" />
      </label>
      <label class="dateFilter"><span>Đến ngày</span>
        <input id="filterDateTo" type="text" placeholder="Chọn ngày" />
      </label>
      <div class="filterActions topFilterActions">
        <button id="applyDateFilter" type="button">Áp dụng</button>
        <button id="clearDateFilter" type="button" class="filterClear">Xóa lọc</button>
      </div>
    </section>

    <section class="card" style="margin-bottom:14px;">
      <h2>Bộ lọc</h2>
      <div class="filters">
        <select id="filterCategory" onchange="renderTable()">
          <option value="">Tất cả mục chi</option>
          <option>Thanh toán giá vốn đối tác</option>
          <option>Thanh toán chi phí Marketing</option>
          <option>Thanh toán chi phí Ads</option>
          <option>Phí Email Getspon</option>
          <option>Chi phí khác</option>
        </select>

        <select id="filterRoute" onchange="renderTable()">
          <option value="">Tất cả chiều</option>
        </select>

        <select id="filterPayer" onchange="renderTable()">
          <option value="">Tất cả người chi</option>
          <option>Long</option>
        </select>

        <select id="filterStatus" onchange="renderTable()">
          <option value="">Tất cả trạng thái</option>
          <option>Đã thanh toán</option>
          <option>Chưa thanh toán</option>
        </select>

        <select id="filterPartner" onchange="renderTable()">
          <option value="">Tất cả đối tác</option>
        </select>

        <select id="filterAds" onchange="renderTable()">
          <option value="">Tất cả nền tảng Ads</option>
          <option>Facebook</option>
          <option>TikTok</option>
          <option>Google</option>
        </select>

        <select id="filterAdsAccount" onchange="renderTable()">
          <option value="">Tất cả tài khoản Ads</option>
          <option>Tài khoản công ty</option>
          <option>Tài khoản Aka</option>
          <option>Tài khoản khác</option>
        </select>

        <select id="filterPayment" onchange="renderTable()">
          <option value="">Tất cả phương thức</option>
          <option>STK cá nhân Long</option>
          <option>STK công ty</option>
          <option>Chuyển khoản công ty</option>
          <option>Thẻ Visa</option>
          <option>Khác</option>
        </select>
      </div>
    </section>

    <div class="tableScroll">
    <table>
      <thead>
        <tr>
          <th>Ngày</th>
          <th>Người chi</th>
          <th>Mục chi</th>
          <th>Chiều</th>
          <th>Đối tác / NV / Ads</th>
          <th>Lý do / Loại TT</th>
          <th>Thanh toán bằng</th>
          <th>Số tiền</th>
          <th>Trạng thái</th>
          <th>Ghi chú</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="tbody"></tbody>
    </table>
    </div>
  </div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>
<script>
const routes = ["Việt Mỹ","Việt Úc","Việt Canada","Việt Đức","Việt Châu Âu","Việt Nhật","Việt Séc","Việt Pháp","Đức Việt","Nhật Việt","Mỹ Việt","Đông lạnh","Shopee"];
const partners = ["Kinkin Logistic","VietExpress","Expolo","Bay Online","Huthui Cargo","AE Express"];

const PAGE_RECORD_TYPE = "chi-tieu-noi-bo";
let records = [];
let dateFilters = { month: "", dateFrom: "", dateTo: "" };
let datePickers = {};

const escapeHtml = value => String(value == null ? "" : value)
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll("'", "&#039;");

async function requestJson(url, options) {
  const response = await fetch(url, options);
  const payload = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(payload.error || "Không thể lưu dữ liệu");
  return payload;
}

async function loadRecords() {
  const payload = await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}`);
  records = payload.records || [];
}

async function saveRecord(record) {
  const payload = await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ record })
  });
  records.unshift(payload.record);
}

async function deleteRecord(id) {
  const actor = prompt("Nhập tên người xoá");
  if (actor === null) return;
  if (!actor.trim()) {
    alert("Vui lòng nhập tên người xoá");
    return;
  }

  const password = prompt("Nhập mật khẩu xoá phiếu");
  if (password === null) return;

  try {
    await requestJson(`/api/page-records/${PAGE_RECORD_TYPE}/${encodeURIComponent(id)}`, {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ actor, password })
    });
    records = records.filter(record => record.id !== id);
    renderTable();
  } catch (error) {
    alert(error.message);
  }
}

function parseMoneyValue(value) {
  return Number(String(value || "").replace(/\D/g, "")) || 0;
}
function formatMoneyInput(input) {
  const raw = input.value.replace(/\D/g, "");
  if (!raw) { input.value = ""; return; }
  input.value = Number(raw).toLocaleString("vi-VN");
}
function money(n) { return Number(n || 0).toLocaleString("vi-VN") + " đ"; }
function categoryText(value) {
  const map = {
    cost:"Thanh toán giá vốn đối tác",
    marketing:"Thanh toán chi phí Marketing",
    ads:"Thanh toán chi phí Ads",
    getspon:"Phí Email Getspon",
    other:"Chi phí khác"
  };
  return map[value];
}
function matchesDateFilter(dateStr) {
  const iso = dateStr && /^\d{4}-\d{2}-\d{2}/.test(dateStr) ? dateStr.slice(0, 10) : null;
  if (!iso) return true;
  const { month, dateFrom, dateTo } = dateFilters;
  if (dateFrom || dateTo) {
    return (!dateFrom || iso >= dateFrom) && (!dateTo || iso <= dateTo);
  }
  if (month) return iso.slice(0, 7) === month;
  return true;
}

function setupDateFilterPickers() {
  if (typeof flatpickr !== "function") return;
  const locale = flatpickr.l10ns && flatpickr.l10ns.vn ? flatpickr.l10ns.vn : "default";
  const commonDateOptions = { altInput: true, altFormat: "d/m/Y", dateFormat: "Y-m-d", allowInput: true, locale, disableMobile: true };

  if (typeof monthSelectPlugin === "function") {
    datePickers.month = flatpickr(document.getElementById("filterMonth"), {
      altInput: true, altFormat: "F Y", dateFormat: "Y-m", locale, disableMobile: true,
      plugins: [new monthSelectPlugin({ shorthand: false, dateFormat: "Y-m", altFormat: "F Y" })],
      onChange: function(selectedDates, value) {
        dateFilters.month = value || "";
        renderTable();
      }
    });
  }
  datePickers.from = flatpickr(document.getElementById("filterDateFrom"), commonDateOptions);
  datePickers.to = flatpickr(document.getElementById("filterDateTo"), commonDateOptions);

  document.getElementById("applyDateFilter").onclick = function() {
    dateFilters.dateFrom = document.getElementById("filterDateFrom").value;
    dateFilters.dateTo = document.getElementById("filterDateTo").value;
    renderTable();
  };
  document.getElementById("clearDateFilter").onclick = function() {
    document.getElementById("filterMonth").value = "";
    document.getElementById("filterDateFrom").value = "";
    document.getElementById("filterDateTo").value = "";
    if (datePickers.month) datePickers.month.clear();
    if (datePickers.from) datePickers.from.clear();
    if (datePickers.to) datePickers.to.clear();
    dateFilters = { month: "", dateFrom: "", dateTo: "" };
    renderTable();
  };
}

function getValue(selectId, otherId, otherTrigger) {
  const val = document.getElementById(selectId)?.value || "";
  if (val === otherTrigger) return document.getElementById(otherId)?.value || val;
  return val;
}
function updatePreview() {
  document.getElementById("amountPreview").textContent = money(parseMoneyValue(document.getElementById("amount").value));
}
async function init() {
  const routeSelect = document.getElementById("route");
  const filterRoute = document.getElementById("filterRoute");
  routes.forEach(r => {
    routeSelect.appendChild(new Option(r, r));
    filterRoute.appendChild(new Option(r, r));
  });
  filterRoute.appendChild(new Option("Chung / Chưa phân bổ", "Chung / Chưa phân bổ"));

  const filterPartner = document.getElementById("filterPartner");
  partners.forEach(p => filterPartner.appendChild(new Option(p,p)));

  document.getElementById("date").valueAsDate = new Date();
  renderForm();
  setupDateFilterPickers();
  try {
    await loadRecords();
  } catch (error) {
    alert(error.message);
  }
  renderTable();
}
function renderForm() {
  const payerType = document.getElementById("payerType").value;
  document.getElementById("payerOtherBox").classList.toggle("hidden", payerType !== "Người khác");

  const c = document.getElementById("category").value;
  document.getElementById("routeBox").classList.toggle("hidden", c === "ads" || c === "getspon");
  document.getElementById("adsRouteNote").classList.toggle("hidden", c !== "ads");
  document.getElementById("getsponRouteNote").classList.toggle("hidden", c !== "getspon");
  document.getElementById("partnerBox").classList.toggle("hidden", c !== "cost");
  document.getElementById("marketingBox").classList.toggle("hidden", c !== "marketing");
  document.getElementById("adsBox").classList.toggle("hidden", c !== "ads");
  document.getElementById("otherBox").classList.toggle("hidden", c !== "other");

  document.getElementById("partnerOtherBox").classList.toggle("hidden", document.getElementById("partner").value !== "Đối tác khác");
  document.getElementById("marketingOtherBox").classList.toggle("hidden", document.getElementById("marketingReason").value !== "Chi phí khác");
  document.getElementById("adsPlatformOtherBox").classList.toggle("hidden", document.getElementById("adsPlatform").value !== "Nền tảng khác");
  document.getElementById("adsAccountOtherBox").classList.toggle("hidden", document.getElementById("adsAccount").value !== "Tài khoản khác");

  updatePreview();
}
function resolveMainAndReason(category) {
  if (category === "cost") {
    return {
      main: getValue("partner", "partnerOther", "Đối tác khác"),
      reason: "Công nợ đối tác"
    };
  }
  if (category === "marketing") {
    return {
      main: "Marketing",
      reason: getValue("marketingReason", "marketingOther", "Chi phí khác")
    };
  }
  if (category === "ads") {
    return {
      main: getValue("adsPlatform", "adsPlatformOther", "Nền tảng khác"),
      reason: getValue("adsAccount", "adsAccountOther", "Tài khoản khác")
    };
  }
  if (category === "getspon") {
    return {
      main: "Email Getspon",
      reason: "Phí Email Getspon"
    };
  }
  return {
    main: document.getElementById("otherName").value || "Chi phí khác",
    reason: "Chi phí khác"
  };
}
async function addRecord() {
  const categoryValue = document.getElementById("category").value;
  const category = categoryText(categoryValue);
  const payer = document.getElementById("payerType").value === "Người khác"
    ? (document.getElementById("payerOther").value || "Người khác")
    : "Long";
  const detail = resolveMainAndReason(categoryValue);
  const amount = parseMoneyValue(document.getElementById("amount").value);

  if (!amount) {
    alert("Vui lòng nhập số tiền");
    return;
  }

  try {
    await saveRecord({
      date: document.getElementById("date").value,
      payer,
      category,
      route: (categoryValue === "ads" || categoryValue === "getspon") ? "Chung / Chưa phân bổ" : document.getElementById("route").value,
      main: detail.main,
      reason: detail.reason,
      payment: document.getElementById("paymentMethod").value,
      amount,
      status: document.getElementById("status").value,
      note: document.getElementById("note").value
    });
  } catch (error) {
    alert(error.message);
    return;
  }

  document.getElementById("amount").value = "";
  document.getElementById("note").value = "";
  updatePreview();
  renderTable();
}
function badgeClass(status) {
  if (status === "Đã thanh toán") return "green";
  return "yellow";
}
function renderTable() {
  const fc = document.getElementById("filterCategory").value;
  const fr = document.getElementById("filterRoute").value;
  const fp = document.getElementById("filterPayer").value;
  const fs = document.getElementById("filterStatus").value;
  const fpartner = document.getElementById("filterPartner").value;
  const fads = document.getElementById("filterAds").value;
  const fadsAccount = document.getElementById("filterAdsAccount").value;
  const fpayment = document.getElementById("filterPayment").value;

  const filtered = records.filter(r =>
    (!fc || r.category === fc) &&
    (!fr || r.route === fr) &&
    (!fp || r.payer === fp) &&
    (!fs || r.status === fs) &&
    (!fpartner || r.main === fpartner) &&
    (!fads || r.main === fads) &&
    (!fadsAccount || r.reason === fadsAccount) &&
    (!fpayment || r.payment === fpayment) &&
    matchesDateFilter(r.date)
  );

  document.getElementById("tbody").innerHTML = filtered.map(r => `
    <tr>
      <td>${escapeHtml(r.date)}</td>
      <td>${escapeHtml(r.payer)}</td>
      <td>${escapeHtml(r.category)}</td>
      <td>${escapeHtml(r.route)}</td>
      <td>${escapeHtml(r.main)}</td>
      <td>${escapeHtml(r.reason)}</td>
      <td>${escapeHtml(r.payment)}</td>
      <td><strong>${money(r.amount)}</strong></td>
      <td><span class="badge ${badgeClass(r.status)}">${escapeHtml(r.status)}</span></td>
      <td>${escapeHtml(r.note || "")}</td>
      <td><button class="deleteBtn" type="button" onclick="deleteRecord('${escapeHtml(r.id)}')">Xoá</button></td>
    </tr>
  `).join("");

  renderSummary(filtered);
}
function sumBy(data, category) {
  return data.filter(r => r.category === category).reduce((s,r)=>s+r.amount,0);
}
function renderSummary(data) {
  document.getElementById("sumTotal").textContent = money(data.reduce((s,r)=>s+r.amount,0));
  document.getElementById("sumCost").textContent = money(sumBy(data, "Thanh toán giá vốn đối tác"));
  document.getElementById("sumMarketing").textContent = money(sumBy(data, "Thanh toán chi phí Marketing"));
  document.getElementById("sumAds").textContent = money(sumBy(data, "Thanh toán chi phí Ads"));
}
init();
</script>
