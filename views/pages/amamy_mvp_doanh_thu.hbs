    </div>
  </section>

  <section class="card" style="padding:0">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="select-col"><input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this.checked)"></th>
            <th>NGÀY</th>
            <th>CHIỀU VẬN CHUYỂN</th>
            <th>SỐ KIỆN</th>
            <th>SỐ KG</th>
            <th>SỐ KHÁCH HÀNG</th>
            <th>DOANH THU</th>
            <th>GIÁ VỐN (CÔNG NỢ)</th>
            <th>ADS</th>
            <th>MARKETING</th>
            <th>ĐỀN BÙ</th>
            <th>ƯU ĐÃI</th>
            <th>PHÍ VIETTEL POST</th>
            <th>PHÍ HOẠT ĐỘNG CỬA HÀNG</th>
            <th>NV PHỤ TRÁCH</th>
            <th>PHÍ NHÂN VIÊN PHỤ TRÁCH</th>
            <th>CHI PHÍ KHÁC</th>
            <th>TỔNG CHI PHÍ</th>
