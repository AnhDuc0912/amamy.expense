<div id="toast" class="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/index.js"></script>
<script>
const routes = ["Việt Nhật","Nhật Việt","Mỹ Việt","Việt Mỹ","Việt Úc","Úc Việt","Việt Canada","Việt Đức","Việt Pháp","Việt Châu Âu","Việt Châu Âu - Đông Lạnh","Việt Séc","Đức Việt","Shopee"];
const colors = ["#2563eb","#6b7280","#fb923c","#059669","#14b8a6","#f97316","#ea580c","#1d8cf8","#4b5563","#b87333","#f97316","#14b8a6","#7e22ce"];
const editableCostFields = ["otherCost"];
const autoCostFields = ["ads","viettelPost","staffFee","marketing","compensation","discount","storeOpFee"];
const PAGE_RECORD_TYPES = ["doanh-thu-san-luong", "doanh-thu"];
let records = [];
let editId = null;
function currentMonthKey() {
  const d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0");
}
let dateFilters = { month: currentMonthKey(), dateFrom: "", dateTo: "" };
let routeFilter = "";
let datePickers = {};
let selectedIds = new Set();
let marketingMap = {};
let compensationMap = {};
let discountMap = {};
let storeOpFeeMap = {};
let giaVonMap = {};
let adsMap = {};
let viettelPostMap = {};
let staffFeeMap = {};

const escapeHtml = value => String(value == null ? "" : value)
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll("'", "&#039;");

async function requestJson(url, options) {
  const response = await fetch(url, options);
  const payload = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(payload.error || "Không thể lưu dữ liệu");
  return payload;
}
async function loadRecords() {
  const payloads = await Promise.all(PAGE_RECORD_TYPES.map(type => requestJson(`/api/page-records/${type}`)));
  records = payloads.flatMap((payload, i) =>
    (payload.records || []).map(record => normalizeRecord(record, PAGE_RECORD_TYPES[i]))
  );
}
function monthKey(dateStr){ return String(dateStr || "").slice(0, 7); }
function bucketKey(route, dateStr){ return route + "|" + monthKey(dateStr); }
function buildSumMap(items, routeFn, dateFn, amountFn, filterFn) {
  const map = {};
  items.forEach(item => {
    if (filterFn && !filterFn(item)) return;
    const key = bucketKey(routeFn(item), dateFn(item));
    map[key] = (map[key] || 0) + (Number(amountFn(item)) || 0);
  });
  return map;
}
function autoValue(map, route, date) {
  return map[bucketKey(route, date)] || 0;
}
async function loadAutoCostMaps() {
  const [khieuNaiPayload, marketingPayload, bootstrapPayload, giaVonPayload, allocPayload, viettelPostAllocPayload, nhanSuPayload] = await Promise.all([
    requestJson("/api/page-records/khieu-nai-den-bu"),
    requestJson("/api/page-records/chi-tieu-noi-bo"),
    requestJson("/api/bootstrap"),
    requestJson("/api/page-records/gia-von"),
    requestJson("/api/page-records/marketing-phan-bo-chieu"),
    requestJson("/api/page-records/chi-phi-viettel-post-phan-bo-chieu"),
    requestJson("/api/page-records/nhan-su")
  ]);
  const khieuNaiRecords = khieuNaiPayload.records || [];
  compensationMap = buildSumMap(khieuNaiRecords, r => r.route, r => r.date, r => r.loss, r => r.category !== "Hoàn ưu đãi");
  discountMap = buildSumMap(khieuNaiRecords, r => r.route, r => r.date, r => r.loss, r => r.category === "Hoàn ưu đãi");

  const marketingRecords = marketingPayload.records || [];
  marketingMap = buildSumMap(marketingRecords, r => r.route, r => r.date, r => r.amount, r => r.category === "Thanh toán chi phí Marketing");

  const expenses = bootstrapPayload.expenses || [];
  storeOpFeeMap = buildSumMap(expenses, r => r.route, r => r.date, r => r.amount, null);

  const giaVonRecords = giaVonPayload.records || [];
  giaVonMap = buildSumMap(giaVonRecords, r => r.route, r => r.date, r => r.amount, null);

  const allocRecords = allocPayload.records || [];
  adsMap = buildSumMap(
    allocRecords,
    r => r.route,
    r => r.date,
    r => (Number(r.facebook)||0) + (Number(r.tiktok)||0) + (Number(r.koc)||0) + (Number(r.other)||0),
    null
  );

  const viettelPostAllocRecords = viettelPostAllocPayload.records || [];
  viettelPostMap = buildSumMap(viettelPostAllocRecords, r => r.route, r => r.date, r => r.amount, null);

  const nhanSuRecords = nhanSuPayload.records || [];
  staffFeeMap = buildSumMap(nhanSuRecords, r => r.route, r => r.date, r => r.amount, r => r.category === "Phí nhân viên phụ trách theo chiều");
}
function attachAutoCosts(rows) {
  const seen = new Set();
  return rows.map(r => {
    const key = bucketKey(r.route, r.date);
    const isFirst = !seen.has(key);
    seen.add(key);
    return {
      ...r,
      cost: isFirst ? autoValue(giaVonMap, r.route, r.date) : 0,
      ads: isFirst ? autoValue(adsMap, r.route, r.date) : 0,
      viettelPost: isFirst ? autoValue(viettelPostMap, r.route, r.date) : 0,
      staffFee: isFirst ? autoValue(staffFeeMap, r.route, r.date) : 0,
      marketing: isFirst ? autoValue(marketingMap, r.route, r.date) : 0,
      compensation: isFirst ? autoValue(compensationMap, r.route, r.date) : 0,
      discount: isFirst ? autoValue(discountMap, r.route, r.date) : 0,
      storeOpFee: isFirst ? autoValue(storeOpFeeMap, r.route, r.date) : 0
    };
  });
}
async function updateRecord(type, id, record) {
  const payload = await requestJson(`/api/page-records/${type}/${encodeURIComponent(id)}`, {
    method: "PUT",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({record})
  });
  const updated = normalizeRecord(payload.record, type);
  records = records.map(item => item.id === id ? updated : item);
}
async function removeRecord(type, id, actor, password) {
  await requestJson(`/api/page-records/${type}/${encodeURIComponent(id)}`, {
    method: "DELETE",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({actor, password})
  });
  records = records.filter(item => item.id !== id);
}
function normalizeRecord(record, type) {
  const r = {
    id: record.id,
    _type: type,
    date: record.date || "",
    route: routes.includes(record.route) ? record.route : routes[0],
    packages: Number(record.packages) || 0,
    kg: Number(record.kg) || 0,
    customers: Number(record.customers) || 0,
    revenue: Number(record.revenue) || 0,
    staffInCharge: record.staffInCharge || "",
    createdAt: record.createdAt || ""
  };
  editableCostFields.forEach(f => r[f] = Number(record[f]) || 0);
  return r;
}
function matchesDateFilter(dateStr) {
  const iso = dateStr && /^\d{4}-\d{2}-\d{2}/.test(dateStr) ? dateStr.slice(0, 10) : null;
  if (!iso) return true;
  const { month, dateFrom, dateTo } = dateFilters;
  if (dateFrom || dateTo) {
    return (!dateFrom || iso >= dateFrom) && (!dateTo || iso <= dateTo);
  }
  if (month) return iso.slice(0, 7) === month;
  return true;
}
function matchesRouteFilter(route) {
  return !routeFilter || route === routeFilter;
}
function matchesFilters(r) {
  return matchesDateFilter(r.date) && matchesRouteFilter(r.route);
}
function setupDateFilterPickers() {
  if (typeof flatpickr !== "function") return;
  const locale = flatpickr.l10ns && flatpickr.l10ns.vn ? flatpickr.l10ns.vn : "default";
  const commonDateOptions = { altInput: true, altFormat: "d/m/Y", dateFormat: "Y-m-d", allowInput: true, locale, disableMobile: true };

  if (typeof monthSelectPlugin === "function") {
    datePickers.month = flatpickr(document.getElementById("filterMonth"), {
      altInput: true, altFormat: "F Y", dateFormat: "Y-m", locale, disableMobile: true,
      defaultDate: dateFilters.month,
      plugins: [new monthSelectPlugin({ shorthand: false, dateFormat: "Y-m", altFormat: "F Y" })],
      onChange: function(selectedDates, value) {
        dateFilters.month = value || "";
        render();
      }
    });
  }
  datePickers.from = flatpickr(document.getElementById("filterDateFrom"), commonDateOptions);
  datePickers.to = flatpickr(document.getElementById("filterDateTo"), commonDateOptions);

  document.getElementById("applyDateFilter").onclick = function() {
    dateFilters.dateFrom = document.getElementById("filterDateFrom").value;
    dateFilters.dateTo = document.getElementById("filterDateTo").value;
    render();
  };
  document.getElementById("clearDateFilter").onclick = function() {
    document.getElementById("filterMonth").value = "";
    document.getElementById("filterDateFrom").value = "";
    document.getElementById("filterDateTo").value = "";
    if (datePickers.month) datePickers.month.clear();
    if (datePickers.from) datePickers.from.clear();
    if (datePickers.to) datePickers.to.clear();
    dateFilters = { month: "", dateFrom: "", dateTo: "" };
    document.getElementById("filterRoute").value = "";
    routeFilter = "";
    render();
  };
  document.getElementById("filterRoute").onchange = function() {
    routeFilter = this.value;
    render();
  };
}
function fmt(n){return new Intl.NumberFormat("vi-VN").format(Number(n)||0)}
function money(n){return fmt(n)+" đ"}
function parseMoney(v){return Number(String(v).replace(/[^\d-]/g,""))||0}
function totalCost(r){return editableCostFields.reduce((sum,f)=>sum+r[f],0)+autoCostFields.reduce((sum,f)=>sum+(r[f]||0),0)}
function operatingProfit(r){return r.revenue-r.cost-totalCost(r)}
function operatingMargin(r){return r.revenue ? operatingProfit(r)/r.revenue*100 : 0}
function setupRoutes(){
  document.getElementById("eRoute").innerHTML = routes.map(r=>`<option>${r}</option>`).join("");
  document.getElementById("filterRoute").innerHTML =
    `<option value="">Tất cả chiều</option>` + routes.map(r=>`<option value="${escapeHtml(r)}">${escapeHtml(r)}</option>`).join("");
}
const moneyInputIds = ["eRevenue",
  ...editableCostFields.map(f=>"e"+f[0].toUpperCase()+f.slice(1))];
moneyInputIds.forEach(id=>{
  document.addEventListener("input",e=>{
    if(e.target.id===id){
      const raw=parseMoney(e.target.value);
      e.target.value=raw?fmt(raw):"";
    }
  });
});
function render(){
  const tb=document.getElementById("tbody");
  const filtered=attachAutoCosts(records.filter(r=>matchesFilters(r)));
  if(!filtered.length){
    tb.innerHTML=`<tr><td colspan="21" class="empty">Chưa có dữ liệu. Hãy nhập ở trang Doanh thu, sản lượng.</td></tr>`;
  } else {
    tb.innerHTML=filtered.map((r,i)=>{
      const profit=operatingProfit(r), marginVal=operatingMargin(r);
      return `
      <tr>
        <td class="select-col"><input type="checkbox" class="rowCheckbox" onchange="toggleSelectRow('${r.id}', this.checked)" ${selectedIds.has(r.id)?"checked":""}></td>
        <td>${escapeHtml(r.date)}</td>
        <td><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${colors[i%colors.length]};margin-right:10px"></span>${escapeHtml(r.route)}</td>
        <td>${fmt(r.packages)}</td>
        <td>${fmt(r.kg)}</td>
        <td>${fmt(r.customers)}</td>
        <td class="money-revenue">${fmt(r.revenue)}</td>
        <td class="money-cost">${fmt(r.cost)}</td>
        <td class="money-cost">${fmt(r.ads)}</td>
        <td class="money-cost">${fmt(r.marketing)}</td>
        <td class="money-cost">${fmt(r.compensation)}</td>
        <td class="money-cost">${fmt(r.discount)}</td>
        <td class="money-cost">${fmt(r.viettelPost)}</td>
        <td class="money-cost">${fmt(r.storeOpFee)}</td>
        <td>${escapeHtml(r.staffInCharge)}</td>
        <td class="money-cost">${fmt(r.staffFee)}</td>
        <td class="money-cost">${fmt(r.otherCost)}</td>
        <td class="money-cost">${fmt(totalCost(r))}</td>
        <td class="money-profit${profit<0?" negative":""}">${fmt(profit)}</td>
        <td class="margin${marginVal<0?" negative":""}">${marginVal.toFixed(2)}%</td>
        <td><div class="row-actions">
          <button class="edit" onclick="openEdit('${r.id}')">✎ Sửa</button>
          <button class="delete" onclick="deleteRecord('${r.id}')">🗑 Xóa</button>
        </div></td>
      </tr>`;
    }).join("");
  }
  const total=filtered.reduce((a,r)=>({
    packages:a.packages+r.packages,kg:a.kg+r.kg,customers:a.customers+r.customers,revenue:a.revenue+r.revenue,cost:a.cost+r.cost,
    ads:a.ads+r.ads,marketing:a.marketing+r.marketing,compensation:a.compensation+r.compensation,
    discount:a.discount+r.discount,viettelPost:a.viettelPost+r.viettelPost,staffFee:a.staffFee+r.staffFee,
    storeOpFee:a.storeOpFee+r.storeOpFee,otherCost:a.otherCost+r.otherCost
  }),{packages:0,kg:0,customers:0,revenue:0,cost:0,ads:0,marketing:0,compensation:0,discount:0,viettelPost:0,staffFee:0,storeOpFee:0,otherCost:0});
  const totalCostSum = filtered.reduce((sum,r)=>sum+totalCost(r),0);
  const p=total.revenue-total.cost-totalCostSum, m=total.revenue?p/total.revenue*100:0;
  document.getElementById("tfoot").innerHTML=`
    <tr><td></td><td></td><td>TỔNG CỘNG</td><td>${fmt(total.packages)}</td><td>${fmt(total.kg)}</td><td>${fmt(total.customers)}</td>
    <td class="money-revenue">${fmt(total.revenue)}</td><td class="money-cost">${fmt(total.cost)}</td>
    <td class="money-cost">${fmt(total.ads)}</td><td class="money-cost">${fmt(total.marketing)}</td>
    <td class="money-cost">${fmt(total.compensation)}</td><td class="money-cost">${fmt(total.discount)}</td>
    <td class="money-cost">${fmt(total.viettelPost)}</td><td class="money-cost">${fmt(total.storeOpFee)}</td>
    <td></td><td class="money-cost">${fmt(total.staffFee)}</td><td class="money-cost">${fmt(total.otherCost)}</td>
    <td class="money-cost">${fmt(totalCostSum)}</td>
    <td class="money-profit${p<0?" negative":""}">${fmt(p)}</td><td class="margin${m<0?" negative":""}">${m.toFixed(2)}%</td><td></td></tr>`;
  sRevenue.textContent=money(total.revenue); sCostOfGoods.textContent=money(total.cost);
  sCost.textContent=money(totalCostSum);
  sProfit.textContent=money(p); sMargin.textContent=m.toFixed(2)+"%";
  updateSelectionUI(filtered);
}
function toggleSelectRow(id, checked){
  if(checked) selectedIds.add(id); else selectedIds.delete(id);
  updateSelectionUI(records.filter(r=>matchesFilters(r)));
}
function toggleSelectAll(checked){
  records.filter(r=>matchesFilters(r)).forEach(r=>{
    if(checked) selectedIds.add(r.id); else selectedIds.delete(r.id);
  });
  render();
}
function updateSelectionUI(filtered){
  const selectedCount = filtered.filter(r=>selectedIds.has(r.id)).length;
  const btn = document.getElementById("bulkDeleteBtn");
  if(btn) btn.textContent = selectedCount ? `🗑 Xóa đã chọn (${selectedCount})` : "🗑 Xóa đã chọn";
  const selectAll = document.getElementById("selectAllCheckbox");
  if(selectAll){
    selectAll.checked = filtered.length>0 && selectedCount===filtered.length;
    selectAll.indeterminate = selectedCount>0 && selectedCount<filtered.length;
  }
}
function openEdit(id){
  editId=id; const r=records.find(x=>x.id===id); if(!r)return;
  eDate.value=r.date;eRoute.value=r.route;ePackages.value=r.packages;eKg.value=r.kg;eCustomers.value=r.customers;
  eRevenue.value=fmt(r.revenue);eStaffInCharge.value=r.staffInCharge;
  editableCostFields.forEach(f=>{
    document.getElementById("e"+f[0].toUpperCase()+f.slice(1)).value=fmt(r[f]);
  });
  modal.classList.add("show");
}
function closeModal(){modal.classList.remove("show");editId=null}
async function saveEdit(){
  const i=records.findIndex(x=>x.id===editId); if(i<0)return;
  const updated={date:eDate.value,route:eRoute.value,packages:Number(ePackages.value)||0,kg:Number(eKg.value)||0,
    customers:Number(eCustomers.value)||0,revenue:parseMoney(eRevenue.value),staffInCharge:eStaffInCharge.value.trim()};
  editableCostFields.forEach(f=>{
    updated[f]=parseMoney(document.getElementById("e"+f[0].toUpperCase()+f.slice(1)).value);
  });
  try {
    await updateRecord(records[i]._type, editId, updated);
    render();closeModal();toast("Đã cập nhật dữ liệu.");
  } catch (error) {
    toast(error.message);
  }
}
async function deleteRecord(id){
  const r=records.find(x=>x.id===id); if(!r)return;
  if(!confirm("Bạn chắc chắn muốn xóa dòng này?"))return;
  const actor = prompt("Nhập tên người xoá");
  if(actor === null) return;
  if(!actor.trim()){toast("Vui lòng nhập tên người xoá.");return}
  const password = prompt("Nhập mật khẩu xoá phiếu");
  if(password === null) return;
  try {
    await removeRecord(r._type, id, actor, password);
    selectedIds.delete(id);
    render();toast("Đã xóa dữ liệu.");
  } catch (error) {
    toast(error.message);
  }
}
async function bulkDelete(){
  const targets = records.filter(r=>selectedIds.has(r.id));
  if(!targets.length){toast("Vui lòng chọn ít nhất một dòng để xóa.");return}
  if(!confirm(`Xóa ${targets.length} dòng đã chọn?`))return;
  const actor = prompt("Nhập tên người xoá");
  if(actor === null) return;
  if(!actor.trim()){toast("Vui lòng nhập tên người xoá.");return}
  const password = prompt("Nhập mật khẩu xoá phiếu");
  if(password === null) return;
  let success=0;
  try {
    for (const r of targets) {
      await removeRecord(r._type, r.id, actor, password);
      selectedIds.delete(r.id);
      success++;
    }
    render();toast(`Đã xóa ${success} dòng đã chọn.`);
  } catch (error) {
    render();toast(error.message);
  }
}
async function resetData(){
  if(!records.length){toast("Không có dữ liệu để xóa.");return}
  if(!confirm("Xóa toàn bộ dữ liệu trên server cho trang này?"))return;
  const actor = prompt("Nhập tên người xoá");
  if(actor === null) return;
  if(!actor.trim()){toast("Vui lòng nhập tên người xoá.");return}
  const password = prompt("Nhập mật khẩu xoá phiếu");
  if(password === null) return;
  try {
    const targets = records.map(record => ({ id: record.id, type: record._type }));
    for (const t of targets) await removeRecord(t.type, t.id, actor, password);
    selectedIds.clear();
    render();toast("Đã xóa toàn bộ dữ liệu.");
  } catch (error) {
    render();toast(error.message);
  }
}
function exportCSV(){
  const rows=[["Ngày","Chiều vận chuyển","Số kiện","Số kg","Số khách hàng","Doanh thu","Giá vốn","Ads","Marketing","Đền bù","Ưu đãi","Phí Viettel Post","Phí hoạt động cửa hàng","NV phụ trách","Phí nhân viên phụ trách","Chi phí khác","Tổng chi phí","Lãi hoạt động","Tỉ suất lãi hoạt động"]];
  attachAutoCosts(records.filter(r=>matchesFilters(r))).forEach(r=>rows.push([r.date,r.route,r.packages,r.kg,r.customers,r.revenue,r.cost,r.ads,r.marketing,r.compensation,r.discount,r.viettelPost,r.storeOpFee,r.staffInCharge,r.staffFee,r.otherCost,totalCost(r),operatingProfit(r),operatingMargin(r).toFixed(2)+"%"]));
  const csv="﻿"+rows.map(row=>row.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\n");
  const blob=new Blob([csv],{type:"text/csv;charset=utf-8"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="doanh-thu.csv";a.click();
  URL.revokeObjectURL(a.href);
}
function toast(msg){
  const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),1800);
}
window.onclick=e=>{if(e.target===modal)closeModal()}
async function init(){
  setupRoutes();
  setupDateFilterPickers();
  render();
  try {
    await Promise.all([loadRecords(), loadAutoCostMaps()]);
  } catch (error) {
    toast(error.message);
  }
  render();
}
init();
</script>
